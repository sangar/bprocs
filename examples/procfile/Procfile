# A Procfile, read as foreman reads it: each line is name: command, run in
# /bin/sh -c with PORT set to 3000 for the first, 3100 for the next and so on.
# A .env beside it is read too. For needs, checks or restarts, write a bprocs.yml.
web: bin/rails server -p $PORT
worker: bundle exec sidekiq
css: bin/rails tailwindcss:watch
